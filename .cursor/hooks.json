{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/queue_edit.ps1",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/queue_edit.ps1",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/publish_queue.ps1",
        "timeout": 180
      }
    ]
  }
}
